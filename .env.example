# WebSocket endpoint of the duel server (a keymania-api deployment).
# Not a secret: it is a public endpoint and ships to the browser.
# Set the same value in Vercel -> Project Settings -> Environment Variables.
#
# Without this, the game still runs single-player against the bot; multiplayer
# shows an "unavailable" notice.
NEXT_PUBLIC_WS_URL=wss://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# HTTP endpoint of the same keymania-api deployment, used for profiles and the
# leaderboard. Deliberately NOT prefixed NEXT_PUBLIC_: it is only ever called
# from Next.js route handlers, which attach the Kinde access token server-side
# so it never reaches browser JavaScript.
#
# Without this, the game and multiplayer still work; the profile dashboard
# reports that the duel server is not configured.
KEYMANIA_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com
